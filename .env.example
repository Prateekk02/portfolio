# Every variable used by the project. Copy the relevant part into
# frontend/.env.local and backend/.env. Never commit real values.

# ---- backend ----
DATABASE_URL=postgresql+asyncpg://app_rw:change-me@localhost:5432/portfolio
CORS_ORIGINS=http://localhost:3000
ADMIN_EMAILS=you@example.com
ADMIN_GITHUB_IDS=12345678
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=http://localhost:3000
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
NOTIFY_EMAIL=you@example.com
FROM_EMAIL=noreply@example.com
REVALIDATE_SECRET=change-me-to-32-random-bytes
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate

# ---- frontend ----
API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_EMAIL_ADDRESS=you@example.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
